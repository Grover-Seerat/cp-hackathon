# Copy this to .env if you use python-dotenv, or just export these vars.

# Set to 1 to skip downloading/running the real Hugging Face model and
# use deterministic fake results instead. Recommended as a safety net
# for the live demo in case venue wifi is unreliable.
DEMO_MODE=0

# Which pretrained Hugging Face model to use for AI-image detection.
DETECTOR_MODEL=umm-maybe/AI-image-detector
